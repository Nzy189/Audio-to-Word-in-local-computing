# Reuse the already deployed dependencies when upgrading from 1.5.8.
# Build context: repository root. No credentials or user data are copied.
ARG BASE_IMAGE=atow-transcriber:1.5.8-ecs
FROM ${BASE_IMAGE}
WORKDIR /app
COPY service/app.py service/index.html service/remote_worker.py service/llm_refine.py ./
